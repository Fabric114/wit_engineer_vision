<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planning</name>
  <version>0.0.1</version>
  <description>纯算法库 (NumPy, 零 ROS): 碰撞检测 / 关节路径 (OMPL) / 装配流形约束, 供 arm_host/planning_node 调用</description>
  <maintainer email="shaozi2233@gmail.com">sxh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 运动学已随本次移植并入 planning 自身 (仓库暂无 task 包), 故不再 depend task。
       numpy/scipy 为硬依赖; OMPL 与 hpp-fcl 是系统级可选后端, 不走 rosdep。 -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
