<!-- rm26 工程机器人仿真场景 -->
<mujoco model="rm26_engineer_scene">

  <include file="rm26_engineer_description/rm26_arm.xml"/>

  <statistic center="0 0 0.5" extent="1.5"/>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <model name="exchange_station" file="exchange_station/exchange_station.xml"/>
  </asset>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
    <scale framelength="2.0" framewidth="0.1"/>
  </visual>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <camera name="fixed_view" pos="0.2 -1 0.5" quat="0.7071 0.7071 0 0" fovy="80"/>
    <!-- 兑换站: 子模型自带 compiler/meshdir (理由见该文件头), prefix 为空 ->-->
    <body name="assembly_platform" pos="0 0 0">
      <geom name="assembly_platform_geom" type="box" size="0.75 0.75 0.075" pos="-0.75 0 0.075"
          rgba="0.35 0.35 0.35 1" contype="0" conaffinity="0"/>
    </body>
    <!-- 挂 O_frame (装配坐标系) 整棵子树, E = exchange_station 在它下面带 6 个规则关节 -->
    <attach model="exchange_station" body="O_frame" prefix=""/>
  </worldbody>

  <!-- 排除"底盘 <-> 臂各节"的接触. -->
  <contact>
    <exclude body1="root" body2="link_1"/>
    <exclude body1="root" body2="link_2"/>
    <exclude body1="root" body2="link_3"/>
    <exclude body1="root" body2="link_4"/>
    <exclude body1="root" body2="link_5"/>
    <exclude body1="root" body2="link_6"/>
    <exclude body1="line_link" body2="link_2"/>
    <exclude body1="line_link" body2="link_3"/>
    <exclude body1="line_link" body2="link_4"/>
    <exclude body1="line_link" body2="link_5"/>
    <exclude body1="line_link" body2="link_6"/>
  </contact>

  <!-- 底盘固定：暂时先改成拉回 -->
  <equality>
    <weld name="chassis_pin" body1="root" solref="0.0002 1"/>
  </equality>

  <!-- 修复路径 -->
  <compiler angle="radian" eulerseq="zyx" autolimits="true"
            strippath="true" meshdir="rm26_engineer_description/meshes"/>

</mujoco>
